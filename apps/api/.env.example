# Preferred runtime: genuine, bounded historical records from Hugging Face.
AMLAAAK_DATA_MODE=huggingface
HF_MAX_RECORDS=300
# Opt in ONLY after the Colab upload and remote verification succeed:
# AMLAAAK_DATA_MODE=prepared
# AMLAAAK_PREPARED_DATA_REPO=thevel0per/AMLAAAK-Real-Estate-Data
# AMLAAAK_PREPARED_DATA_REVISION=<verified immutable dataset commit from notebook>
# AMLAAAK_PREPARED_DATA_MANIFEST_SHA256=<verified manifest SHA256 from notebook>
# HF_TOKEN=<private dataset READ token; backend only>
# HF_TOKEN=  # Optional, server-only; never send to a browser.
# Offline: set AMLAAAK_DATA_MODE=illustrative, or snapshot with an explicit path.
# AMLAAAK_SNAPSHOT=assets/sample.json
# AMLAAAK_MODEL_DIR=assets/model
# Genuine-data artifact, after explicit offline training/export:
# AMLAAAK_MODEL_DIR=assets/divar-model
# Approved public artifact; all three trust settings must remain paired.
AMLAAAK_MODEL_REPO=thevel0per/AMLAAAK-Price-Predictor
AMLAAAK_MODEL_REVISION=89de24728daecdec3731e07475ab985c1efa87ad
AMLAAAK_MODEL_MANIFEST_SHA256=a8d51e5f441b30a541b92ac33fb7838a39c0d8da1ce5b051cd3a67e55e98d3e5
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
# Set the same strong random value in the web project's API_TOKEN.
# AMLAAAK_API_TOKEN=
