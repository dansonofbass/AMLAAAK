# Preferred runtime: genuine, bounded historical records from Hugging Face.
AMLAAAK_DATA_MODE=huggingface
HF_MAX_RECORDS=300
# HF_TOKEN=  # Optional, server-only; never send to a browser.
# Offline: set AMLAAAK_DATA_MODE=illustrative, or snapshot with an explicit path.
# AMLAAAK_SNAPSHOT=assets/sample.json
# AMLAAAK_MODEL_DIR=assets/model
# Genuine-data artifact, after explicit offline training/export:
# AMLAAAK_MODEL_DIR=assets/divar-model
# Optional remote model provisioning requires all three pinned trust settings:
# AMLAAAK_MODEL_REPO=approved-owner/approved-model-repo
# AMLAAAK_MODEL_REVISION=40-character-commit-sha
# AMLAAAK_MODEL_MANIFEST_SHA256=64-character-manifest-hash
# Set the same strong random value in the web project's API_TOKEN.
# AMLAAAK_API_TOKEN=
